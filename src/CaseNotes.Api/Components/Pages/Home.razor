    }
    
    /* Recording Active */
    .recording-active {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    .recording-indicator {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: #fee2e2;
        border-radius: 12px;
    }
    
    .pulse {
        width: 12px;
        height: 12px;
        background: #ef4444;
        border-radius: 50%;
        animation: pulse 1.5s ease-in-out infinite;
    }
    
    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.1); }
    }
    
    .recording-text {
        font-weight: 600;
        color: #991b1b;
    }
    
    /* Processing */
    .processing {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 2rem;
    }
    
    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #e5e7eb;
        border-top-color: #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    
    .processing p {
        color: #6b7280;
        font-weight: 500;
    }
    
    /* Success Message */
    .success-message {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background: #d1fae5;
        border-radius: 12px;
        color: #065f46;
        font-weight: 600;
    }
    
    .success-message i {
        font-size: 1.5rem;
    }
    
    /* Info Text */
    .info-text {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6b7280;
        font-size: 0.875rem;
    }
    
    /* Transcript Box */
    .transcript-box {
        background: #f9fafb;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.5rem;
        max-height: 300px;
        overflow-y: auto;
        font-size: 1rem;
        line-height: 1.6;
        color: #374151;
    }
    
    /* Note Box */
    .note-box {
        background: #f9fafb;
        border: 2px solid #10b981;
        border-radius: 12px;
        padding: 1.5rem;
        max-height: 500px;
        overflow-y: auto;
        font-size: 0.95rem;
        line-height: 1.8;
        color: #1f2937;
    }
    
    .note-box strong {
        color: #667eea;
        font-weight: 700;
    }
    
    /* HIPAA Notice */
    .hipaa-notice {
        padding: 1rem;
        background: #fef3c7;
        border: 2px solid #f59e0b;
        border-radius: 12px;
        font-size: 0.875rem;
        color: #92400e;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }
    
    .hipaa-notice i {
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    
    /* Error Card */
    .error-card {
        background: #fee2e2;
        border: 2px solid #ef4444;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: #991b1b;
    }
    
    .error-card i {
        font-size: 1.5rem;
        flex-shrink: 0;
    }
    
    /* Loading Spinner */
    .loading-spinner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 2rem;
    }
    
    .loading-spinner p {
        color: #6b7280;
        font-weight: 500;
    }
    
    /* Responsive */
    @@media (max-width: 640px) {
        .app-container {
            padding: 1rem 0.5rem;
        }
        
        .app-header, .status-card, .section-card {
            padding: 1.5rem;
        }
        
        .logo-section h1 {
            font-size: 1.5rem;
        }
        
        .action-buttons {
            flex-direction: column;
        }
        
        .action-buttons .btn {
            width: 100%;
        }
    }
</style>

@code {
    // Component state
    private bool modelsReady = true; // Start as true to prevent flicker, will update on first check
    private bool isRecording = false;
    private bool isProcessing = false;
    private bool isGenerating = false;
    private string processingStatus = "";
    private string errorMessage = "";
    private string transcript = "";
    private string structuredNote = "";
    private ModelStatus? modelStatus;
    
    // Store audio data from JavaScript callback
    private string? _receivedAudioData;
    private TaskCompletionSource<string>? _audioDataTcs;
    private System.Threading.Timer? _timer;
    
    protected override async Task OnInitializedAsync()
    {
        await CheckModelStatus();
        
        // Poll for model readiness if not ready
        if (!modelsReady)
        {
            _timer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await CheckModelStatus();
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
    }
    
    private async Task CheckModelStatus()
    {
        try
        {
            modelStatus = await Http.GetFromJsonAsync<ModelStatus>("/api/models/status");
            modelsReady = modelStatus?.AllModelsReady ?? false;
            
            if (modelsReady && _timer != null)
            {
                await _timer.DisposeAsync();
                _timer = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to check model status: {ex.Message}";
        }
    }
    
    [JSInvokable]
    public Task ReceiveAudioData(string base64Audio)
    {
        _receivedAudioData = base64Audio;
        _audioDataTcs?.TrySetResult(base64Audio);
        return Task.CompletedTask;
    }
    
    private async Task StartRecording()
    {
        try
        {
            errorMessage = "";
            isRecording = true;
            await JS.InvokeVoidAsync("startRecording");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to start recording: {ex.Message}";
            isRecording = false;
        }
    }
    
    private async Task StopRecording()
    {
        try
        {
            isRecording = false;
            isProcessing = true;
            processingStatus = "Processing audio...";
            StateHasChanged();
            
            // Get the audio blob from JavaScript with callback pattern
            // Real-world: 10-20 minute recordings need generous timeout
            _audioDataTcs = new TaskCompletionSource<string>();
            var cts = new CancellationTokenSource(TimeSpan.FromMinutes(5));
            
            byte[] audioData;
            var dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                // Pass ONLY dotNetHelper (no CancellationToken - can't be serialized!)
                await JS.InvokeVoidAsync("stopRecording", dotNetRef);
                
                // Apply timeout on C# side when waiting for callback
                var base64Audio = await _audioDataTcs.Task.WaitAsync(cts.Token);
                
                if (string.IsNullOrEmpty(base64Audio))
                {
                    errorMessage = "No audio data captured. Please try recording again.";
                    return;
                }
                
                // Decode base64 to byte array
                try
                {
                    audioData = Convert.FromBase64String(base64Audio);
                }
                catch (FormatException)
                {
                    errorMessage = "Invalid audio data format. Please try recording again.";
                    return;
                }
                
                if (audioData.Length == 0)
                {
                    errorMessage = "No audio data captured. Please try recording again.";
                    return;
                }
            }
            finally
            {
                dotNetRef.Dispose();
            }
            
            processingStatus = "Transcribing audio...";
            StateHasChanged();
            
            // Call transcription service directly (Blazor Server runs on server - no HTTP needed)
            // Use extended timeout for long audio processing (10-20 minute recordings)
            try
            {
                var requestCts = new CancellationTokenSource(TimeSpan.FromMinutes(10));
                var request = new TranscriptionRequest { AudioData = audioData };
                var result = await TranscriptionService.TranscribeAsync(request, requestCts.Token);
                
                if (result.Success)
                {
                    transcript = result.Text ?? "";
                    
                    // Auto-generate note after transcription
                    if (!string.IsNullOrWhiteSpace(transcript))
                    {
                        processingStatus = "Generating case note...";
                        StateHasChanged();
                        
                        try
                        {
                            await GenerateNote();
                            _logger.LogInformation("Auto-generation completed successfully");
                        }
                        catch (Exception genEx)
                        {
                            errorMessage = $"Generation error: {genEx.Message}";
                            _logger.LogError(genEx, "Auto-generation failed after transcription");
                            
                            // Don't crash - just show error and stay ready for next recording
                            try
                            {
                                await InvokeAsync(StateHasChanged);
                            }
                            catch
                            {
                                // Ignore UI update errors
                            }
                        }
                    }
                }
                else
                {
                    errorMessage = $"Transcription failed: {result.ErrorMessage}";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Transcription error: {ex.Message}";
            }
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Recording processing timed out after 5 minutes. This may indicate a problem with the audio or transcription service.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing audio: {ex.Message}";
            _logger.LogError(ex, "Audio processing failed: {Message}", ex.Message);
        }
        finally
        {
            isProcessing = false;
            processingStatus = "";
            
            try
            {
                await InvokeAsync(StateHasChanged);
                _logger.LogInformation("Audio processing complete, ready for next recording");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to update UI after processing: {Message}", ex.Message);
            }
        }
    }
    
    private async Task GenerateNote()
    {
        try
        {
            isGenerating = true;
            errorMessage = "";
            structuredNote = "";
            StateHasChanged();
            
            _logger.LogInformation("Starting note generation...");
            
            // Call generation service directly with timeout
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(2));
            var request = new GenerationRequest 
            { 
                TranscriptText = transcript, 
                MaxLength = 2048, 
                Temperature = 0.7 
            };
            
            var result = await TextGenerationService.GenerateAsync(request, cts.Token);
            
            _logger.LogInformation("Generation service returned: Success={Success}", result.Success);
            
            if (result.Success)
            {
                structuredNote = result.StructuredNote ?? "";
                _logger.LogInformation("✅ Note generation complete: {Length} chars", structuredNote.Length);
            }
            else
            {
                errorMessage = $"Failed to generate case note: {result.ErrorMessage}";
                _logger.LogError("Generation failed: {Error}", result.ErrorMessage);
            }
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Generation timed out after 2 minutes.";
            _logger.LogWarning("Generation timeout");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating case note: {ex.Message}";
            _logger.LogError(ex, "Generation crashed: {Message}", ex.Message);
        }
        finally
        {
            isGenerating = false;
            
            try
            {
                await InvokeAsync(StateHasChanged);
                _logger.LogInformation("Generation workflow complete, UI updated");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to update UI after generation: {Message}", ex.Message);
            }
        }
    }
    
    private async Task CopyToClipboard()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", structuredNote);
    }
    
    private void ResetRecording()
    {
        transcript = "";
        structuredNote = "";
        errorMessage = "";
        isRecording = false;
        isProcessing = false;
        isGenerating = false;
    }
    
    private string FormatMarkdown(string text)
    {
        // Basic markdown-to-HTML conversion
        text = System.Web.HttpUtility.HtmlEncode(text);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        text = text.Replace("\n", "<br/>");
        return text;
    }
    
