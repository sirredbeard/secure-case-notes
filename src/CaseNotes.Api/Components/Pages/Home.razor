@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Text.Json
@using CaseNotes.Core.Interfaces
@using CaseNotes.Core.Models
@using Microsoft.Extensions.Logging
@inject HttpClient Http
@inject ITranscriptionService TranscriptionService
@inject ITextGenerationService TextGenerationService
@inject IJSRuntime JS
@inject ILogger<Home> _logger

<PageTitle>Secure Case Notes</PageTitle>

<div class="app-container">
    <header class="app-header">
        <div class="header-content">
            <div class="logo-section">
                <i class="bi bi-shield-lock-fill"></i>
                <h1 tabindex="-1">Secure Case Notes</h1>
            </div>
            <p class="subtitle">HIPAA-Compliant AI-Assisted Documentation</p>
        </div>
    </header>
    
    <main class="main-content">
        @* Model Status Section - Only show when downloading *@
        @if (!modelsReady)
        {
            <div class="status-card downloading">
                <div class="status-header">
                    <i class="bi bi-cloud-arrow-down-fill"></i>
                    <h2>Downloading AI Models</h2>
                </div>
                
                @if (modelStatus != null)
                {
                    <div class="model-progress">
                        @* Speech-to-Text Model *@
                        <div class="model-item">
                            <div class="model-header">
                                <span class="model-name">
                                    <i class="bi bi-mic-fill"></i>
                                    Sherpa Zipformer (Speech-to-Text)
                                </span>
                                <span class="model-status">
                                    @if (modelStatus.WhisperModel?.IsDownloaded == true)
                                    {
                                        <span class="badge badge-success">✓ Ready</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-downloading">
                                            @string.Format("{0:0}%", modelStatus.WhisperModel?.DownloadProgress ?? 0)
                                        </span>
                                    }
                                </span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @(modelStatus.WhisperModel?.DownloadProgress ?? 0)%"></div>
                            </div>
                        </div>
                        
                        @* Phi-4 Model *@
                        <div class="model-item">
                            <div class="model-header">
                                <span class="model-name">
                                    <i class="bi bi-file-earmark-text-fill"></i>
                                    Phi-4 (Text Generation)
                                </span>
                                <span class="model-status">
                                    @if (modelStatus.TextGenerationModel?.IsDownloaded == true)
                                    {
                                        <span class="badge badge-success">✓ Ready</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-downloading">
                                            @string.Format("{0:0}%", modelStatus.TextGenerationModel?.DownloadProgress ?? 0)
                                        </span>
                                    }
                                </span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @(modelStatus.TextGenerationModel?.DownloadProgress ?? 0)%"></div>
                            </div>
                        </div>
                    </div>
                    
                    <p class="download-info">
                        <i class="bi bi-info-circle-fill"></i>
                        First-time download: ~3GB. Models are cached for future use.
                    </p>
                }
                else
                {
                    <div class="loading-spinner">
                        <div class="spinner"></div>
                        <p>Checking model availability...</p>
                    </div>
                }
            </div>
        }
        
        @* Recording Section *@
        <div class="section-card">
            <div class="section-header">
                <span class="step-number">1</span>
                <h3>Record Session</h3>
            </div>
            <div class="section-body">
                @if (!isRecording && string.IsNullOrEmpty(transcript))
                {
                    <button class="btn btn-record" 
                            @onclick="StartRecording" 
                            disabled="@(!modelsReady || isProcessing)">
                        <i class="bi bi-mic-fill"></i>
                        <span>Start Recording</span>
                    </button>
                    <p class="info-text">
                        <i class="bi bi-shield-check"></i>
                        Audio processed in memory only — never saved to disk
                    </p>
                }
                else if (isRecording)
                {
                    <div class="recording-active">
                        <div class="recording-indicator">
                            <span class="pulse"></span>
                            <span class="recording-text">Recording in progress...</span>
                        </div>
                        <button class="btn btn-stop" @onclick="StopRecording">
                            <i class="bi bi-stop-circle-fill"></i>
                            <span>Stop Recording</span>
                        </button>
                    </div>
                }
                else if (isProcessing)
                {
                    <div class="processing">
                        <div class="spinner"></div>
                        <p>@processingStatus</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(transcript))
                {
                    <div class="success-message">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Recording complete</span>
                    </div>
                }
            </div>
        </div>
        
        @* Transcript Section *@
        @if (!string.IsNullOrEmpty(transcript))
        {
            <div class="section-card">
                <div class="section-header">
                    <span class="step-number">2</span>
                    <h3>Transcript</h3>
                </div>
                <div class="section-body">
                    <div class="transcript-box">
                        @transcript
                    </div>
                    
                    @if (!isGenerating && string.IsNullOrEmpty(structuredNote))
                    {
                        <button class="btn btn-generate" @onclick="GenerateNote">
                            <i class="bi bi-magic"></i>
                            <span>Generate Structured Note</span>
                        </button>
                    }
                    else if (isGenerating)
                    {
                        <div class="processing">
                            <div class="spinner"></div>
                            <p>Generating structured case note...</p>
                        </div>
                    }
                </div>
            </div>
        }
        
        @* Structured Note Section *@
        @if (!string.IsNullOrEmpty(structuredNote))
        {
            <div class="section-card">
                <div class="section-header">
                    <span class="step-number">3</span>
                    <h3>Structured Case Note</h3>
                </div>
                <div class="section-body">
                    <div class="note-box">
                        @((MarkupString)FormatMarkdown(structuredNote))
                    </div>
                    
                    <div class="action-buttons">
                        <button class="btn btn-primary" @onclick="CopyToClipboard">
                            <i class="bi bi-clipboard-check"></i>
                            <span>Copy to Clipboard</span>
                        </button>
                        <button class="btn btn-secondary" @onclick="ResetRecording">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>New Note</span>
                        </button>
                    </div>
                    
                    <div class="hipaa-notice">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>HIPAA Notice:</strong> This note exists only in browser memory. 
                        Copy to your EHR immediately. No data is stored locally or transmitted externally.
                    </div>
                </div>
            </div>
        }
        
        @* Error Display *@
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-card">
                <i class="bi bi-x-circle-fill"></i>
                <p>@errorMessage</p>
            </div>
        }
    </main>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    
    *:focus {
        outline: none;
    }
    
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        color: #2d3748;
    }
    
    .app-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }
    
    /* Header */
    .app-header {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .header-content {
        text-align: center;
    }
    
    .logo-section {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }
    
    .logo-section i {
        font-size: 2.5rem;
        color: #667eea;
    }
    
    .logo-section h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #1a202c;
    }
    
    .subtitle {
        font-size: 1rem;
        color: #718096;
        font-weight: 400;
    }
    
    /* Main Content */
    .main-content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    
    /* Status Card */
    .status-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .status-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    
    .status-header i {
        font-size: 2rem;
    }
    
    .status-card.downloading .status-header i {
        color: #f59e0b;
        animation: pulse 2s ease-in-out infinite;
    }
    
    .status-card.ready .status-header i {
        color: #10b981;
    }
    
    .status-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
    }
    
    /* Model Progress */
    .model-progress {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    
    .model-item {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    
    .model-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .model-name {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        color: #4a5568;
    }
    
    .model-name i {
        color: #667eea;
    }
    
    .badge {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 600;
    }
    
    .badge-success {
        background: #d1fae5;
        color: #065f46;
    }
    
    .badge-downloading {
        background: #fef3c7;
        color: #92400e;
    }
    
    /* Progress Bar */
    .progress-bar {
        width: 100%;
        height: 8px;
        background: #e5e7eb;
        border-radius: 4px;
        overflow: hidden;
    }
    
    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        transition: width 0.3s ease;
        border-radius: 4px;
    }
    
    .download-info {
        margin-top: 1rem;
        padding: 1rem;
        background: #f3f4f6;
        border-radius: 8px;
        font-size: 0.875rem;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .ready-message {
        color: #065f46;
        font-weight: 500;
    }
    
    /* Section Card */
    .section-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    
    .step-number {
        width: 2rem;
        height: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.125rem;
    }
    
    .section-header h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1a202c;
    }
    
    .section-body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.875rem 1.5rem;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
